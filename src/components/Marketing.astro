---
import SiteDocument from '../layouts/SiteDocument.astro';
import { coreFaqs } from '../content/faqs';
const { lang = 'zh' } = Astro.props;
const zh = lang === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const download = 'https://owlcam.app/download';
const features = [
  [t('按时间找到录像','Find the day, then the moment'),t('在日历和时间轴中选择日期，查看缩略图并播放。','Choose a date, browse the timeline, and play a clip.'),'01',t('日历与时间轴','Calendar & timeline')],
  [t('每台摄像头独立录制','Every angle, its own recording'),t('内置摄像头、USB 摄像头，或通过连续互通相机接入的 iPhone。多路独立检测，按摄像头保存。','Use a built-in camera, USB webcam, or iPhone via Continuity Camera. Each camera detects and records independently.'),'02',t('多摄像头 · PRO','Multiple cameras · PRO')],
  [t('录像与备份，由你掌控','Your files, your storage rules'),t('录像是普通 MP4。Pro 可设置存储上限与保留规则，把录完的文件备份到指定 NAS 或外接硬盘。','Recordings are ordinary MP4 files. Pro adds storage limits, retention rules, and backups of finished recordings to your NAS or external drive.'),'03',t('存储与备份 · PRO','Storage & backup · PRO')],
];
const faqs = coreFaqs(lang);
---
<SiteDocument path={zh ? "/zh" : "/"} description={t("把 Mac 和现有摄像头变成本地事件录像工具。持续记录、时间轴回看，单摄像头永久免费；Pro $29 一次买断。", "Turn your Mac and existing camera into a local event recorder. Keep events together and review on a timeline. One camera free forever; Pro is $29 once.")} title={t('Owl Cam — 用 Mac 录像，活动留在本机','Owl Cam — Your Mac, your camera, your recordings')} lang={lang}>
  <nav aria-label={t('主导航','Main navigation')}><div class="wrap nav-in">
    <a class="brand" href={zh ? '/zh' : '/'}><img src="/icon-256.png" alt="" width="30" height="30"/>Owl Cam</a>
    <div class="navlinks"><a class="desktop" href="#how">{t('为什么 Owl Cam','Why Owl Cam')}</a><a class="desktop" href="#features">{t('功能','Features')}</a><a class="desktop" href="#pricing">{t('价格','Pricing')}</a><a class="desktop" href="#faq">FAQ</a><a href={zh ? "/zh/blog" : "/blog"}>{t("博客","Blog")}</a><a class="language" href={zh ? '/' : '/zh'} lang={zh ? 'en' : 'zh'}>{zh ? 'EN' : '中文'}</a><a class="button small primary" href={download}>{t('免费下载','Download free')} <span aria-hidden="true">↓</span></a></div>
  </div></nav>
  <main>
    <header class="hero"><div class="aurora" aria-hidden="true"></div><div class="wrap hero-in">
      <a href="https://github.com/wuyumo/owlcam-releases/releases/tag/v1.1.7" class="version"><span class="status"></span>{t('1.1.7 已发布 · 录像更可靠','1.1.7 is here · More reliable recording')} <span aria-hidden="true">↗</span></a>
      <p class="eyebrow">{t('为 macOS 而生 · 画面在本地处理','MADE FOR MAC · PROCESSED LOCALLY')}</p>
      <h1>{t('用 Mac 录像，','Your Mac, your camera')}<br/><span>{t('活动留在本机','Your recordings')}</span></h1>
      <p class="hero-copy">{t('用 Mac 和现有摄像头记录房间活动。','Turn your Mac and camera into a local recorder.')}{' '}<br class="desktop"/>{t('有活动就录，检测到人时继续录制。随时在时间轴回看。','Record activity, keep recording while a person is detected, and review it on a timeline.')}</p>
      <div class="actions"><a class="button primary" href={download}><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg>{t('免费下载 Mac 版','Download free for Mac')}</a><a class="button secondary" href="#how">{t('看看它怎么记录','See how it records')} <span aria-hidden="true">↓</span></a></div>
      <p class="compatibility">{t('macOS 14+ · Apple 芯片与 Intel · Apple 公证','macOS 14+ · Apple silicon & Intel · Notarized by Apple')}</p>
      <div class="trust"><span>{t('一台摄像头永久免费','One camera, free forever')}</span><i></i><span>{t('无需注册','No account needed')}</span><i></i><span>{t('Pro 一次买断','One-time Pro purchase')}</span></div>
      <figure class="product"><button class="screenshot-button" data-open-image aria-label={t('查看完整实时画面截图','View full live-view screenshot')}><img src="/shot-live.jpg" width="1440" height="901" alt={t('Owl Cam 多摄像头实时画面，显示独立的录像状态与倒计时','Owl Cam live view with separate recording states and countdowns for multiple cameras')} fetchpriority="high"/></button></figure>
    </div></header>
    <section class="usecases wrap" aria-label={t('适用场景','Use cases')}><p class="eyebrow">{t('让现有设备，多一份用处','A NEW USE FOR WHAT YOU ALREADY OWN')}</p><div class="usecase-grid"><article><span>01 / {t('家中','HOME')}</span><h3>{t('出门后的房间','The room you leave behind')}</h3><p>{t('门口、桌边、宠物常待的角落。回来后看看发生了什么。','The doorway, your desk, your pet’s favorite corner. Come back to a record of what happened.')}</p></article><article><span>02 / {t('工作室','STUDIO')}</span><h3>{t('有人进出的空间','A space with people coming and going')}</h3><p>{t('用现有 Mac 和 USB 摄像头，记录工作台或工作室的活动。','Use a Mac and USB webcam to record activity around your workbench or studio.')}</p></article><article><span>03 / {t('闲置 iPhone','SPARE IPHONE')}</span><h3>{t('让闲置 iPhone 再派上用场','Give your spare iPhone a new job')}</h3><p>{t('通过连续互通相机，把兼容的 iPhone 用作摄像头，在 Mac 上检测和录制。','Use a compatible iPhone as a camera with Continuity Camera. Owl Cam detects and records activity on your Mac.')}</p></article></div></section>
    <section id="how" class="section wrap"><div class="section-heading"><div><p class="eyebrow">{t('01 / 记录完整的过程','01 / KEEP THE CONTEXT')}</p><h2>{t('画面有人，','Still there')}<br/>{t('就继续录','Still recording')}</h2></div><p>{t('Owl Cam 在本机检测动作和人物。即使人暂时不动，检测到人时也会继续录制。','Owl Cam detects motion and people on your Mac. When a person is detected, recording continues even if they sit still.')}</p></div>
      <div class="event-demo"><div class="demo-head"><span class="label">{t('一个下午，在工作台前','An afternoon at the workbench')}</span><span class="demo-note">{t('交互原理示意，非实际录像数据','Interactive illustration, not measured recording data')}</span></div>
        <div class="scenario-buttons" role="group" aria-label={t('选择事件阶段','Choose an event stage')}>
          <button data-scene="0" aria-pressed="false">01 <span>{t('走进房间','Enter the room')}</span></button><button data-scene="1" aria-pressed="true">02 <span>{t('坐下，暂时不动','Sit still for a while')}</span></button><button data-scene="2" aria-pressed="false">03 <span>{t('离开画面','Leave the frame')}</span></button>
        </div>
        <div class="timeline-demo" data-phase="1"><div class="axis"><span>14:00</span><span>14:05</span><span>14:10</span><span>14:15</span><span>14:20</span></div><div class="track"><span class="track-name">{t('仅按动作判断','Movement only')}<small>{t('可能出现的分段','Possible clip splits')}</small></span><div class="track-line fragmented" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div><div class="track"><span class="track-name owl-track">Owl Cam<small>{t('人像识别已开启','Person detection on')}</small></span><div class="track-line continuous" aria-hidden="true"><span><b class="live-dot"></b>{t('同一次事件，持续记录','One event, kept together')}</span></div></div><div class="phase-marker" aria-hidden="true"></div></div>
        <div class="demo-result" aria-live="polite"><span class="live-dot"></span><p data-scene-caption>{t('检测到人仍在画面里。即使动作暂停，也继续保持这段录像。','A person is still detected in frame. Recording stays active, even while movement pauses.')}</p></div>
      </div>
      <div class="how-notes"><p><b>{t('录下触发前的画面','Capture what happened before')}</b>{t('预录缓冲保留触发前的一小段画面；实际长度取决于预录设置和内存预算。','Pre-roll retains a short stretch before the trigger, depending on your settings and memory budget.')}</p><p><b>{t('长事件保存在同一个文件','Keep long events in one file')}</b>{t('1.1.6 起取消 15 分钟自动分段。持续录制仍取决于活动检测、设备状态和可用空间。','Since 1.1.6, no automatic 15-minute splits. Ongoing recording still depends on detection, device state, and free space.')}</p></div>
      <details class="technical"><summary>{t('想自己调整检测？看看实时曲线','Want to tune detection? See the live charts')} <span>+</span></summary><div><p>{t('动作触发、场景差异和停止条件都能单独调整。实时读数帮助你针对机位和光线做设置。','Adjust motion triggers, scene-difference thresholds, and stopping rules separately. Live readings help tune your camera position and lighting.')}</p><a href="/shot-detection.png" target="_blank" rel="noreferrer"><img src="/shot-detection.png" width="1440" height="1826" loading="lazy" alt={t('检测设置的实时曲线和阈值','Live detection charts and thresholds')}/></a></div></details>
    </section>
    <section id="features" class="section wrap"><div class="section-heading"><div><p class="eyebrow">{t('02 / 从记录到回看','02 / RECORD · FIND · KEEP')}</p><h2>{t('录得下来，','Record and find')}<br/>{t('也要找得到、留得住','Yours to keep')}</h2></div><p>{t('从第一秒的画面，到几天后的回看和备份。每一步都在你熟悉的 Mac 上完成。','From the first frame to reviewing and backing up days later, everything happens on the Mac you already know.')}</p></div>
      <div class="feature-grid">{features.map(([title,copy,n,label])=><article class={`feature feature-${n}`}><span class="eyebrow">{label}</span><h3>{title}</h3><p>{copy}</p>{n==='01'?<div class="mini-calendar" aria-hidden="true"><div class="calendar-month">NOVEMBER <span>‹　›</span></div><div class="days">{['M','T','W','T','F','S','S',...Array.from({length:14},(_,i)=>String(i+1))].map((v,i)=><span class:list={{selected:i===9,marked:[7,9,10,14,17].includes(i)}}>{v}</span>)}</div><div class="calendar-timeline"><i></i><i></i><i></i><b></b></div><small>{t('日历与时间轴示意','Calendar and timeline illustration')}</small></div>:n==='02'?<div class="camera-list" aria-hidden="true">{['USB Camera','FaceTime HD','iPhone Camera'].map((c,i)=><div><span class="camera-symbol">▣</span><span>{c}</span><i class:list={{on:i!==1}}></i></div>)}<small>{t('设备类型示意 · iPhone 需满足连续互通相机条件','Illustrative devices · Continuity Camera requirements apply')}</small></div>:<div class="file-tree" aria-hidden="true"><span>▱　Owl Cam / Studio /</span><strong>　↳ 2026-11-03</strong><code>　　 14-00-00.mp4</code><div><span>Mac</span><b>→</b><span>{t('你的 NAS / 硬盘','Your NAS / drive')}</span></div></div>}</article>)}</div>
      <div class="feature-foot"><span>{t('还有：可选录音','Also: optional audio')}</span><span>{t('Pro：烙印时间戳','Pro: burned-in timestamps')}</span><span>{t('Pro：自动暂停时段','Pro: scheduled pauses')}</span><span>{t('Pro：按摄像头单独设置','Pro: per-camera settings')}</span></div>
    </section>
    <section id="privacy" class="section wrap"><div class="privacy-panel"><div><p class="eyebrow">{t('03 / 本地优先','03 / LOCAL BY DESIGN')}</p><h2>{t('你的房间','Your room')}<br/>{t('你的录像','Your recordings')}<br/><span>{t('你选的位置','Your choice of storage')}</span></h2><p class="privacy-intro">{t('检测和录制都在 Mac 上完成。开始使用无需注册。','Detection and recording run on your Mac. No account required.')}</p></div><div class="privacy-details"><article><span>01</span><div><h3>{t('普通 MP4，不被格式锁住','Ordinary MP4, no format lock-in')}</h3><p>{t('保存到你选择的文件夹，可用 QuickTime 打开，移动或自行归档。','Save to a folder you choose. Open in QuickTime, move, or archive your files.')}</p></div></article><article><span>02</span><div><h3>{t('备份去哪里，由你决定','Back up wherever you choose')}</h3><p>{t('Pro 将已结束的录像复制到指定位置。选择 NAS、外接硬盘或云同步目录时，文件会按你的设置离开本机。','Pro copies finished recordings to your chosen destination. A NAS or cloud-synced folder sends files beyond the Mac according to your settings.')}</p></div></article><article><span>03</span><div><h3>{t('联网行为，也说清楚','Network activity, explained')}</h3><p>{t('App 会联网检查更新，可在设置中关闭。Pro 密钥校验也需联网；这些流程不上传摄像头画面。','The app checks for updates online; you can disable automatic checks. Pro licence validation also uses the network. These processes don’t upload camera footage.')}</p></div></article></div></div></section>
    <section id="pricing" class="section wrap"><div class="center-heading"><p class="eyebrow">{t('04 / 简单的价格','04 / SIMPLE PRICING')}</p><h2>{t('免费开始','Start free')}<br/>{t('需要更多，再升级 Pro','Buy once when you need more')}</h2><p>{t('Pro 免费试用 14 天，无需注册或银行卡。','Try Pro free for 14 days. No account or card required.')}</p></div>
      <div class="pricing"><article class="plan"><div class="plan-name"><h3>{t('免费版','Free')}</h3><span>{t('适合一个机位','For a single camera')}</span></div><div class="price">$0 <small>{t('永久免费','forever')}</small></div><p>{t('完整的本地检测、录制与回看。','The essentials for local recording and review.')}</p><ul>{[t('1 台摄像头','1 camera'),t('动作、场景差异与本机人像识别','Motion, scene & on-device person detection'),t('预录与可选录音','Pre-roll and optional audio'),t('日历、时间轴与录像回放','Calendar, timeline & playback'),t('内置检测预设','Built-in detection presets')].map(f=><li>{f}</li>)}</ul><a class="button secondary" href={download}>{t('免费下载','Download free')} <span>↓</span></a><small>{t('试用结束后，单摄像头核心功能仍可免费使用。','Core single-camera features stay free after the trial.')}</small></article>
      <article class="plan pro"><div class="plan-name"><h3>Owl Cam Pro</h3><span class="pro-tag">{t('一次买断','ONE-TIME')}</span></div><div class="price">$29 <small>{t('一次性 · 2 台 Mac','once · 2 Macs')}</small></div><p>{t('更多机位，更完整的保存与管理。','More cameras. More control over what you keep.')}</p><ul>{[t('包含免费版全部功能','Everything in Free'),t('不限摄像头数量，按机位单独设置','Unlimited cameras & per-camera settings'),t('可定制的烙印时间戳','Customizable burned-in timestamps'),t('自动备份与条件筛选','Automatic backups & backup conditions'),t('存储上限、清理与保护规则','Storage limits, cleanup & protection rules'),t('自动暂停时段与自定义检测预设','Scheduled pauses & custom presets')].map(f=><li>{f}</li>)}</ul><a class="button primary" href="https://owlcam.app/buy">{t('购买 Pro','Get Pro')} <span>↗</span></a><small>{t('不订阅。付款与税费由 Polar 处理。','No subscription. Payments and taxes handled by Polar.')}</small></article></div>
    </section>
    <section id="faq" class="section wrap faq"><div class="faq-heading"><p class="eyebrow">{t('下载前，你可能还想知道','BEFORE YOU DOWNLOAD')}</p><h2>{t('几个实际问题','A few practical questions')}</h2><p>{t('它在 Mac 上记录，供你事后回看。','It records on your Mac for later review.')}</p></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div><a class="all-faq" href={zh ? "/zh/faq" : "/faq"}>{t("查看全部常见问题", "All questions")} →</a></section>
    <section class="closing wrap"><img src="/icon-256.png" alt="" width="64" height="64"/><h2>{t('让你的 Mac，','Turn your Mac')}<br/>{t('帮你照看空间','into a local recorder')}</h2><p>{t('下载，接上摄像头，试录你的第一个事件。','Download, connect a camera, and record your first event.')}</p><a class="button primary" href={download}>{t('免费下载 Mac 版','Download free for Mac')} <span>↓</span></a><small>{t('一台摄像头永久免费 · 无需注册 · macOS 14+','One camera, free forever · No account · macOS 14+')}</small></section>
  </main>
  <footer class="wrap"><a class="brand" href={zh?'/zh':'/'}><img src="/icon-256.png" alt="" width="24" height="24"/>Owl Cam</a><span>© 2026 Owl Cam</span><div><a href={zh ? "/zh/blog" : "/blog"}>{t("博客","Blog")}</a><a href={zh ? "/zh/privacy" : "/privacy"}>{t('隐私','Privacy')}</a><a href={zh ? "/zh/faq" : "/faq"}>FAQ</a><a href="https://github.com/wuyumo/owlcam-releases/releases">{t('更新说明','Releases')}</a><a href="https://owlcam.app/account">{t('管理订单','Account')}</a><a href="mailto:hi@owlcam.app">{t('联系','Support')}</a></div></footer>
  <dialog class="image-dialog" aria-label={t('产品截图','Product screenshot')}><button class="close-image" aria-label={t('关闭截图','Close screenshot')}>×</button><img src="/shot-live.jpg" width="1440" height="901" alt={t('Owl Cam 多路实时画面完整截图','Full screenshot of Owl Cam multi-camera live view')}/></dialog>
  <script define:vars={{ captions: [t('检测到动作，开始录制，并补上预录缓冲里的画面。','Movement detected: recording starts, including frames from the pre-roll buffer.'),t('检测到人仍在画面里。即使动作暂停，也继续保持这段录像。','A person is still detected in frame. Recording stays active, even while movement pauses.'),t('人离开后，等待设置的无活动时间，再结束这段录像。','After the person leaves, the configured inactivity countdown allows the recording to finish.')] }}>
    document.querySelectorAll('[data-scene]').forEach(button=>button.addEventListener('click',()=>{const phase=Number(button.dataset.scene);document.querySelectorAll('[data-scene]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelector('.timeline-demo').dataset.phase=String(phase);document.querySelector('[data-scene-caption]').textContent=captions[phase];}));
    const dialog=document.querySelector('.image-dialog');document.querySelectorAll('[data-open-image]').forEach(b=>b.addEventListener('click',()=>dialog.showModal()));document.querySelector('.close-image').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
  </script>
</SiteDocument>
<style>
