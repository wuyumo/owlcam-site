---
import InfoPage from '../layouts/InfoPage.astro';
const { lang } = Astro.props;
const zh = lang === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const sections = [
 [t('画面在本机处理','On-device camera processing'), [t('Owl Cam 在 Mac 上采集摄像头与可选的麦克风输入，执行活动检测、人像识别、编码、录像和回放。人像识别使用 Apple Vision 框架，不需要将画面上传到云端分析。','Owl Cam captures camera and optional microphone input on your Mac, where activity detection, person detection, encoding, recording, and playback take place. Person detection uses Apple’s Vision framework without uploading camera frames for cloud analysis.'),t('开始前会由 macOS 请求相机与麦克风权限。可以在应用设置中关闭录音，也可以在 macOS 系统设置中管理这些权限。','macOS requests camera and microphone permissions. You can turn audio recording off in the app and manage permissions in macOS System Settings.')]],
 [t('录像与本地数据','Recordings and local data'), [t('录像以普通 MP4 文件保存到你选择的目录。你可以使用 QuickTime 打开、复制、移动或删除文件。应用还会在本机保存偏好设置、录像事件索引及运行日志，用于配置、回看和排查问题。','Recordings are ordinary MP4 files saved in the directory you choose. You can open them in QuickTime, copy, move, or delete them. The app also stores preferences, a recording event index, and operational logs locally for settings, review, and troubleshooting.'),t('你选择的保存位置决定了文件可能去哪里。例如 iCloud 或其他云同步目录可能由相应服务自动同步，NAS 或网络目录可能将文件写入另一台设备。这些传输由你选定的位置与相关服务设置决定。','Your storage location determines where files may go. For example, iCloud or another cloud-synced folder may sync files through that service, while a NAS or network directory may store them on another device. These transfers follow your destination choice and the relevant service settings.')]],
 [t('更新检查与下载','Update checks and downloads'), [t('Owl Cam 使用 Sparkle 检查和安装更新。自动检查启用时，会联网请求官网更新源；检查时不上传摄像头画面、录音或录像文件。官网的更新源与安装包目前通过 GitHub Releases 提供。相关服务会按其运营方式处理网络请求，例如接收请求 IP 等连接信息。','Owl Cam uses Sparkle to check for and install updates. When automatic checking is enabled, it requests the website’s update feed online without uploading camera frames, audio, or recordings. The feed and installers are currently served through GitHub Releases. These services handle network requests in their normal operation, including connection information such as the requesting IP address.'),t('可以在设置 → 通用关闭自动检查，再按需手动检查或从官网下载。关闭自动检查不会关闭你主动发起的下载或更新请求。','You can disable automatic checks under Settings → General, then check manually or download from the website. Disabling automatic checks does not disable downloads or update requests you initiate.')]],
 [t('Pro 密钥与购买','Pro licences and purchases'), [t('验证 Pro 密钥时，应用将你填写的密钥与 Owl Cam 的组织标识发送到 Polar 验证接口，以确认授权状态。应用会在本机缓存验证时间与授权信息；这些请求不包含录像画面。','When validating Pro, the app sends the key you enter and Owl Cam’s organization identifier to Polar’s validation endpoint to confirm licence status. Validation time and licence information are cached locally. These requests do not contain camera footage.'),t('购买、付款、税费处理和订单管理通过 Polar 完成；结账时填写的信息由 Polar 及其相关支付服务按各自规则处理。开始免费使用或试用 Owl Cam，无需创建应用账户；购买及订单管理可能需要邮箱等结账信息。','Purchases, payments, tax handling, and order management use Polar. Checkout information is handled by Polar and its payment services under their policies. Using Owl Cam’s free features or trial requires no app account; purchases and order management may require an email address and other checkout information.')]],
 [t('你指定的备份位置','Backups you configure'), [t('Pro 可以把已结束的录像复制到你指定的备份位置，包括 NAS、外接硬盘或其他文件夹。使用网络或云同步位置时，录像可能按你的配置离开 Mac。你负责选择适合的访问权限与保存位置。','Pro can copy finished recordings to backup destinations you configure, including a NAS, external drive, or another folder. Using a network or cloud-synced location may transfer recordings beyond your Mac according to your configuration. Choose appropriate destinations and access permissions.'),t('可在备份设置中关闭或更改后续备份。关闭备份不会自动删除已复制到目的地的文件。存储清理也按你启用的规则执行。','You can disable or change future backups in Settings. Disabling backup does not automatically remove files already copied to a destination. Storage cleanup also follows the rules you enable.')]],
 [t('App 与网站的访问统计','App and website analytics'), [t('Owl Cam App 不内置使用行为统计或崩溃上报。官网与 App 分开运行：官网加载 Vercel Web Analytics 访问统计脚本，用于了解网站访问情况。网站请求和支付页面由对应托管或支付服务处理；它们不会因此获得本机摄像头录像。','The Owl Cam app does not include usage analytics or crash reporting. The website operates separately and loads Vercel Web Analytics to understand website visits. Website requests and payment pages are handled by the relevant hosting or payment providers; visiting them does not give those services access to local camera recordings.')]],
 [t('删除与联系','Deletion and contact'), [t('你可以自行删除录像与备份文件，或按应用内规则进行清理。卸载应用不会自动删除已保存的录像、本地配置或日志。需要协助清理本地数据、处理授权或订单问题，请联系 hi@owlcam.app。','You can delete recordings and backup files yourself or use in-app cleanup rules. Uninstalling the app does not automatically delete saved recordings, local settings, or logs. For help with local data removal, licences, or orders, contact hi@owlcam.app.')]],
];
---
<InfoPage title={t('Owl Cam — 隐私与存储','Owl Cam — Privacy and storage')} description={t('检测与录制在 Mac 本机完成。保存、同步与备份去向由你选择，联网行为在这里说明。','Detection and recording run on your Mac. You choose storage, sync, and backup destinations. Here is how network activity works.')} lang={lang} kind="privacy">
 <p>{t('更新日期：2026 年 11 月 3 日','Last updated: November 3, 2026')}</p>
 {sections.map(([heading, paragraphs]) => <section><h2>{heading}</h2>{(paragraphs as string[]).map(copy=><p>{copy}</p>)}</section>)}
 <div class="note"><p><a href="mailto:hi@owlcam.app">hi@owlcam.app</a> · <a href="https://polar.sh/legal/privacy">{t('Polar 隐私政策','Polar privacy policy')}</a> · <a href="https://vercel.com/docs/analytics/privacy-policy">{t('Vercel Web Analytics 隐私说明','Vercel Web Analytics privacy information')}</a></p></div>
</InfoPage>
