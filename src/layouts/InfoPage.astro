---
import SiteDocument from './SiteDocument.astro';
const { title, description, lang, kind } = Astro.props;
const zh = lang === 'zh';
const home = zh ? '/zh' : '/';
const page = `${zh ? '/zh' : ''}/${kind}`;
const alternate = `${zh ? '' : '/zh'}/${kind}`;
const t = (cn: string, en: string) => zh ? cn : en;
---
<SiteDocument title={title} description={description} lang={lang} path={page}>
<nav aria-label={t('主导航','Main navigation')}><div class="frame nav-in"><a class="brand" href={home}><img src="/icon-256.png" alt="" width="30" height="30"/>Owl Cam</a><div class="links"><a class="desktop" href={`${home}#how`}>{t('为什么 Owl Cam','Why Owl Cam')}</a><a class="desktop" href={`${home}#pricing`}>{t('价格','Pricing')}</a><a href={`${zh?'/zh':''}/blog`}>{t('博客','Blog')}</a><a href={alternate}>{zh?'EN':'中文'}</a><a class="button" href="/download">{t('免费下载','Download free')} ↓</a></div></div></nav>
<main class="frame"><a class="back" href={home}>← {t('回到首页','Back to home')}</a><header><p class="eyebrow">{kind === 'faq' ? 'QUESTIONS & ANSWERS' : 'PRIVACY & STORAGE'}</p><h1>{title.replace('Owl Cam — ','')}</h1><p class="intro">{description}</p></header><div class="content"><slot/></div></main>
<footer class="frame"><span>© 2026 Owl Cam</span><div><a href={`${zh?'/zh':''}/blog`}>{t('博客','Blog')}</a><a href={`${zh?'/zh':''}/faq`}>FAQ</a><a href={`${zh?'/zh':''}/privacy`}>{t('隐私','Privacy')}</a><a href="https://github.com/wuyumo/owlcam-releases/releases">{t('更新说明','Releases')}</a><a href="/account">{t('管理订单','Account')}</a><a href="mailto:hi@owlcam.app">{t('联系','Support')}</a></div></footer>
</SiteDocument>
<style>
.frame{width:min(1080px,calc(100% - 64px));margin:auto}nav{position:sticky;top:0;z-index:20;background:#0b0e13d9;backdrop-filter:blur(20px);border-bottom:1px solid var(--color-rule)}.nav-in{min-height:76px;display:flex;justify-content:space-between;align-items:center}.brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:650;letter-spacing:-.5px}.brand img{border-radius:7px}.links{display:flex;gap:26px;align-items:center;font-size:13px;color:var(--color-muted)}.button{background:var(--color-accent);color:var(--color-accent-ink);padding:10px 16px;border-radius:10px;font-size:12px;font-weight:600}.button:hover{background:var(--color-accent-hover)}main.frame{max-width:850px;padding:45px 0 80px}.back{font-size:12px;color:var(--color-accent)}header{padding:45px 0 35px;border-bottom:1px solid var(--color-rule)}.eyebrow{font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;color:var(--color-accent)}h1{font-size:clamp(34px,5vw,52px);font-weight:600;letter-spacing:-.035em;margin-top:16px}.intro{font-size:16px;color:var(--color-muted);margin-top:18px;max-width:650px;line-height:1.9}.content{padding-top:24px}footer{padding:28px 0 40px;border-top:1px solid var(--color-rule);font-size:12px;color:var(--color-dim);display:flex;justify-content:space-between;gap:20px}footer>div{display:flex;gap:24px}a:hover{color:var(--color-accent)}
.content :global(h2){font-size:23px;font-weight:600;letter-spacing:-.02em;margin:38px 0 16px}.content :global(p){font-size:15px;color:var(--color-muted);line-height:1.95;margin:12px 0}.content :global(a){color:var(--color-accent)}.content :global(code){font-family:var(--font-mono);font-size:12px;overflow-wrap:anywhere;background:#ffffff07;border-radius:4px;padding:2px 5px}.content :global(details){border-top:1px solid var(--color-rule);padding:0}.content :global(details:last-of-type){border-bottom:1px solid var(--color-rule)}.content :global(summary){cursor:pointer;list-style:none;padding:20px 0;display:flex;justify-content:space-between;gap:18px;font-size:15px;font-weight:550}.content :global(summary::-webkit-details-marker){display:none}.content :global(summary::after){content:'+';color:var(--color-accent);font-family:var(--font-mono);font-size:19px}.content :global(details[open] summary::after){content:'−'}.content :global(details p){margin:0;padding:0 0 22px}.content :global(.note){padding:18px 22px;margin-top:32px;border:1px solid var(--color-rule);border-radius:12px;background:var(--color-paper-raised)}
@media(max-width:640px){.frame{width:calc(100% - 40px)}.desktop{display:none}.links{gap:18px}.brand{font-size:17px}.brand img{width:26px;height:26px}.nav-in{min-height:65px}main.frame{padding-top:27px}header{padding-top:32px}.intro{font-size:14px}.content :global(p){font-size:14px}.content :global(summary){font-size:14px}footer{flex-direction:column}footer>div{gap:18px;flex-wrap:wrap}}
</style>
