---
// Site skeleton: head/meta + the shared design system (ListenIn "Dark Aurora" tokens).
interface Props { title: string; description: string; lang: 'en' | 'zh'; path: string; }
const { title, description, lang, path } = Astro.props;
const ORIGIN = 'https://owlcam.app';
const B = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const canonical = `${ORIGIN}${path === '/' ? '/' : path.replace(/\/$/, '')}`;
const en = path.startsWith('/zh') ? (path === '/zh' ? '/' : path.slice(3)) : path;
const zh = path.startsWith('/zh') ? path : (path === '/' ? '/zh' : `/zh${path}`);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${ORIGIN}/#org`, name: 'Owl Cam', url: ORIGIN, logo: `${ORIGIN}/icon-256.png` },
    { '@type': 'SoftwareApplication', name: 'Owl Cam', operatingSystem: 'macOS 14+', applicationCategory: 'SecurityApplication',
      offers: [{ '@type': 'Offer', price: '0', priceCurrency: 'USD' }, { '@type': 'Offer', price: '29', priceCurrency: 'USD', name: 'Pro' }],
      url: ORIGIN, downloadUrl: `${ORIGIN}/download` },
  ],
};
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={`${ORIGIN}${en}`} />
  <link rel="alternate" hreflang="zh-CN" href={`${ORIGIN}${zh}`} />
  <link rel="icon" href={`${B}/icon-256.png`} />
  <link rel="apple-touch-icon" href={`${B}/apple-touch-icon.png`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${ORIGIN}/og.png`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0A0C10" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </head>
<body>
  <nav>
    <div class="wrap nav-in">
      <a class="brand" href={B + (lang === 'zh' ? '/zh' : '/')}><img src={`${B}/icon-256.png`} width="26" height="26" alt="" /> Owl Cam</a>
      <div class="nav-links">
        <a class="hide-sm" href={B + (lang === 'zh' ? '/zh' : '/') + '#how'}>{lang === 'zh' ? '原理' : 'How it works'}</a>
        <a class="hide-sm" href={B + (lang === 'zh' ? '/zh' : '/') + '#pricing'}>{lang === 'zh' ? '价格' : 'Pricing'}</a>
        <a class="hide-sm" href={B + (lang === 'zh' ? '/zh/faq' : '/faq')}>FAQ</a>
        <a href={B + (lang === 'zh' ? en : zh)}>{lang === 'zh' ? 'EN' : '中文'}</a>
        <a class="btn primary" href={`${B}/download`}>{lang === 'zh' ? '下载' : 'Download'}</a>
      </div>
    </div>
  </nav>
  <slot />
  <footer>
    <div class="wrap foot-in">
      <span>© 2026 Owl Cam · {lang === 'zh' ? '独立开发者作品' : 'Made by an indie developer'}</span>
      <span class="foot-links">
        <a href={B + (lang === 'zh' ? '/zh/privacy' : '/privacy')}>{lang === 'zh' ? '隐私' : 'Privacy'}</a>
        <a href={B + (lang === 'zh' ? '/zh/faq' : '/faq')}>FAQ</a>
        <a href="https://github.com/wuyumo/owlcam-releases/releases">{lang === 'zh' ? '版本' : 'Releases'}</a>
        <a href={`${B}/account`}>{lang === 'zh' ? '管理订单' : 'Account'}</a>
        <a href="mailto:hi@owlcam.app">{lang === 'zh' ? '联系' : 'Support'}</a>
      </span>
    </div>
  </footer>

  <style is:global>
    @import "../tokens.css";
    :root{
      --bg:var(--color-paper); --bg2:var(--color-paper-high); --card:var(--color-paper-raised); --card2:var(--color-paper-high);
      --line:var(--color-rule); --line2:var(--color-rule-strong); --ink:var(--color-ink); --muted:var(--color-muted); --dim:var(--color-dim);
      --accent:var(--color-accent); --accent-hover:var(--color-accent-hover); --accent-ink:var(--color-accent-ink); --glow:var(--color-glow);
      --shadow:var(--color-shadow); --mono:var(--font-mono); --sans:var(--font-body); --r:14px; --content:880px;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;overflow-x:clip}
    body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:16.5px;line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:clip}
    a{color:var(--accent);text-decoration:none} a:hover{color:var(--accent-hover)}
    .wrap{max-width:1020px;margin:0 auto;padding:0 24px}
    nav{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);background:color-mix(in srgb,var(--bg) 78%,transparent)}
    .nav-in{display:flex;align-items:center;gap:26px;height:60px}
    .brand{display:flex;align-items:center;gap:10px;color:var(--ink);font-weight:650;font-size:16px;letter-spacing:-.01em}
    .brand img{border-radius:6px}
    .nav-links{display:flex;gap:22px;margin-left:auto;align-items:center;font-size:14px}
    .nav-links a{color:var(--muted);white-space:nowrap} .nav-links a:hover{color:var(--ink)}
    @media (max-width:640px){.nav-links a.hide-sm{display:none}}
    .btn{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;border-radius:11px;padding:10px 20px;font-size:15px;font-weight:600;border:.5px solid var(--line2);color:var(--ink);background:var(--card);cursor:pointer;transition:transform var(--dur-micro) var(--ease-out),background-color var(--dur-micro) var(--ease-out)}
    .btn:hover{background:var(--card2);color:var(--ink);transform:translateY(-1px)}
    .btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);box-shadow:0 8px 24px -14px var(--glow)}
    .btn.primary:hover{background:var(--accent-hover);color:var(--accent-ink);border-color:var(--accent-hover)}
    .btn.big{padding:14px 28px;font-size:16.5px;border-radius:13px}
    .btn-note{font-size:13px;color:var(--dim);margin-top:10px}
    .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}
    h1{font-size:clamp(34px,5.5vw,58px);line-height:1.12;letter-spacing:-.022em;font-weight:700;text-wrap:balance}
    h2{font-size:clamp(24px,3vw,32px);line-height:1.25;letter-spacing:-.015em;font-weight:700;text-wrap:balance}
    h3{font-size:17px;font-weight:650;letter-spacing:-.01em}
    .lede{color:var(--muted);font-size:clamp(16px,1.8vw,19px);max-width:60ch}
    .hero{padding:84px 0 40px;position:relative;overflow:hidden}
    .hero-glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(900px 440px at 50% 112%,var(--glow),transparent 62%),radial-gradient(520px 300px at 84% -16%,oklch(70% .09 290/.09),transparent 65%),radial-gradient(460px 280px at 8% -10%,oklch(80% .07 215/.07),transparent 65%)}
    .hero-glow::after{content:"";position:absolute;inset:0;background-image:linear-gradient(oklch(95% .01 250/.028) 1px,transparent 1px),linear-gradient(90deg,oklch(95% .01 250/.028) 1px,transparent 1px);background-size:72px 72px;-webkit-mask-image:radial-gradient(72% 62% at 50% 42%,#000 18%,transparent 100%);mask-image:radial-gradient(72% 62% at 50% 42%,#000 18%,transparent 100%)}
    .hero-in{display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;position:relative}
    .hero .lede{margin:0 auto}
    .cta-row{display:flex;gap:14px;align-items:center;flex-wrap:wrap;justify-content:center}
    .shot{width:min(var(--content),100%);margin:28px auto 0;border-radius:var(--r);border:.5px solid var(--line2);box-shadow:0 30px 80px -30px var(--shadow);overflow:hidden;background:var(--card)}
    .shot img{display:block;width:100%;height:auto}
    section{padding:72px 0}
    .sec-in{max-width:var(--content);margin:0 auto;display:flex;flex-direction:column;gap:18px}
    .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:8px}
    .card{background:var(--card);border:.5px solid var(--line);border-radius:var(--r);padding:20px 22px;display:flex;flex-direction:column;gap:8px}
    .card p{color:var(--muted);font-size:15px;line-height:1.6}
    .card .k{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}
    .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:8px}
    @media (max-width:720px){.steps{grid-template-columns:1fr}}
    .step{background:var(--card);border:.5px solid var(--line);border-radius:var(--r);padding:20px 22px}
    .step b{display:block;font-family:var(--mono);font-size:12px;color:var(--accent);letter-spacing:.14em;margin-bottom:8px}
    .step p{color:var(--muted);font-size:15px;line-height:1.6}
    .rule{display:flex;gap:14px;align-items:flex-start;padding:14px 0;border-top:.5px solid var(--line)}
    .rule:last-child{border-bottom:.5px solid var(--line)}
    .rule .dot{width:12px;height:12px;border-radius:50%;flex:none;margin-top:8px}
    .rule p{color:var(--muted);font-size:15px}
    .rule b{color:var(--ink);font-weight:600}
    .pricing{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:8px}
    @media (max-width:720px){.pricing{grid-template-columns:1fr}}
    .plan{background:var(--card);border:.5px solid var(--line);border-radius:var(--r);padding:26px 26px;display:flex;flex-direction:column;gap:12px}
    .plan.pro{border-color:var(--accent);box-shadow:0 20px 60px -30px var(--glow)}
    .plan .price{font-size:38px;font-weight:700;letter-spacing:-.03em;line-height:1}
    .plan .price small{font-size:15px;color:var(--muted);font-weight:500;letter-spacing:0}
    .plan ul{list-style:none;display:flex;flex-direction:column;gap:7px;color:var(--muted);font-size:15px}
    .plan li::before{content:"✓ ";color:var(--accent)}
    .plan li.no{color:var(--dim)} .plan li.no::before{content:"— ";color:var(--dim)}
    details{border-top:.5px solid var(--line);padding:14px 0}
    details:last-of-type{border-bottom:.5px solid var(--line)}
    summary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;gap:12px}
    summary::after{content:"+";color:var(--dim);font-family:var(--mono)} details[open] summary::after{content:"–"}
    details p{color:var(--muted);font-size:15px;margin-top:8px;max-width:70ch}
    .prose{max-width:70ch;color:var(--muted)} .prose h2{color:var(--ink);margin:32px 0 10px;font-size:22px} .prose p{margin:0 0 12px}
    footer{border-top:.5px solid var(--line);padding:28px 0 48px;color:var(--dim);font-size:13.5px}
    .foot-in{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
    .foot-links{display:flex;gap:18px} .foot-links a{color:var(--dim)} .foot-links a:hover{color:var(--ink)}
    code{font-family:var(--mono);font-size:.9em;background:var(--card2);padding:2px 6px;border-radius:5px}
  </style>
</body>
</html>
