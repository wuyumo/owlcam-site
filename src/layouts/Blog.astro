---
import SiteDocument from './SiteDocument.astro';
import { blogPath } from '../lib/blog';
const {title, description, lang, path, article = false} = Astro.props;
const zh = lang === 'zh';
const home = zh ? '/zh' : '/';
const alternate = zh ? path.slice(3) : `/zh${path}`;
---
<SiteDocument title={title} description={description} lang={lang} path={path} ogType={article ? 'article' : 'website'}>
  <Fragment slot="head"><link rel="alternate" type="application/rss+xml" title={zh ? 'Owl Cam 博客' : 'Owl Cam Blog'} href={`${blogPath(lang)}/rss.xml`}/><slot name="head"/></Fragment>
  <nav aria-label={zh ? '主导航' : 'Main navigation'}><div class="frame nav-inner"><a class="brand" href={home}><img src="/icon-256.png" width="30" height="30" alt=""/>Owl Cam</a><div class="nav-links"><a href={blogPath(lang)}>{zh ? '博客' : 'Blog'}</a><a class="desktop" href={`${home}#pricing`}>{zh ? '价格' : 'Pricing'}</a><a href={alternate} lang={zh ? 'en' : 'zh-CN'}>{zh ? 'EN' : '中文'}</a><a class="button" href="/download">{zh ? '免费下载' : 'Download free'} ↓</a></div></div></nav>
  <main class="frame"><slot/></main>
  <footer class="frame"><span>© 2026 Owl Cam</span><div><a href={blogPath(lang)}>{zh ? '博客' : 'Blog'}</a><a href={`${blogPath(lang)}/editorial`}>{zh ? '内容说明' : 'Editorial policy'}</a><a href={`${home === '/' ? '' : home}/faq`}>FAQ</a><a href={`${home === '/' ? '' : home}/privacy`}>{zh ? '隐私' : 'Privacy'}</a><a href="mailto:hi@owlcam.app">{zh ? '联系' : 'Support'}</a></div></footer>
</SiteDocument>
<style is:global>
.frame{width:min(1080px,calc(100% - 64px));margin:auto}.nav-inner{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}nav{position:sticky;top:0;z-index:20;background:#0b0e13ed;backdrop-filter:blur(20px);border-bottom:1px solid var(--color-rule)}.brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:650}.brand img{border-radius:7px}.nav-links{display:flex;align-items:center;gap:24px;font-size:14px;color:var(--color-muted)}.button{display:inline-block;background:var(--color-accent);color:var(--color-accent-ink);padding:10px 16px;border-radius:10px;font-size:13px;font-weight:600}.button:hover{background:var(--color-accent-hover);color:var(--color-accent-ink)}.eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;color:var(--color-accent)}.back{font-size:13px;color:var(--color-accent)}.blog-header{padding:64px 0 42px;max-width:780px}.blog-header h1{font-size:clamp(32px,5vw,52px);line-height:1.3;letter-spacing:-.035em;font-weight:600;margin-top:16px}.intro{font-size:17px;color:var(--color-muted);margin-top:22px;line-height:1.9}.meta{color:var(--color-dim);font-size:13px;margin-top:22px}.post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-bottom:72px}.post-card{padding:28px;border:1px solid var(--color-rule);border-radius:14px;background:var(--color-paper-raised);display:flex;flex-direction:column;gap:14px}.post-card h2{font-size:23px;line-height:1.45;letter-spacing:-.02em;font-weight:550}.post-card p{font-size:15px;line-height:1.85;color:var(--color-muted)}.post-card a:hover{color:var(--color-accent)}.post-card .read{color:var(--color-accent);font-size:13px;margin-top:auto}.article-layout{display:grid;grid-template-columns:minmax(0,740px) 230px;gap:64px;padding-bottom:64px}.prose{min-width:0;overflow-wrap:anywhere}.prose h2{font-size:26px;line-height:1.45;font-weight:600;letter-spacing:-.02em;margin:40px 0 16px}.prose h3{font-size:20px;margin:28px 0 12px}.prose p,.prose li{font-size:16px;line-height:1.95;color:var(--color-muted)}.prose p{margin:16px 0}.prose strong{color:var(--color-ink);font-weight:600}.prose ul,.prose ol{padding-left:24px}.prose li{margin:9px 0}.prose a{color:var(--color-accent);text-decoration:underline;text-underline-offset:3px}.prose img{border-radius:12px;border:1px solid var(--color-rule);height:auto;margin:26px 0}.toc{position:sticky;top:105px;align-self:start;font-size:13px;border-left:1px solid var(--color-rule);padding-left:22px}.toc p{color:var(--color-dim);margin-bottom:14px}.toc a{display:block;color:var(--color-muted);margin:12px 0;line-height:1.65}.toc a:hover{color:var(--color-accent)}.article-cta{padding:28px;border:1px solid var(--color-rule);border-radius:14px;margin:40px 0;background:var(--color-paper-raised)}.article-cta p{color:var(--color-muted);margin:12px 0 20px;font-size:15px}.related{margin-bottom:55px}.related>h2{font-size:24px;margin-bottom:22px}.related .post-grid{margin-bottom:0}.editorial-note{font-size:13px;color:var(--color-dim);margin-bottom:28px}.editorial-note a{color:var(--color-accent)}footer{border-top:1px solid var(--color-rule);padding:28px 0 40px;display:flex;justify-content:space-between;gap:24px;font-size:12px;color:var(--color-dim)}footer>div{display:flex;gap:22px;flex-wrap:wrap}footer a:hover{color:var(--color-accent)}
@media(max-width:900px){.article-layout{grid-template-columns:minmax(0,1fr);gap:0}.toc{display:none}.post-grid{gap:16px}}
@media(max-width:640px){.frame{width:calc(100% - 40px)}.desktop{display:none}.nav-inner{min-height:65px;gap:12px}.brand{font-size:16px;gap:7px}.brand img{width:25px;height:25px}.nav-links{gap:13px;font-size:12px}.button{padding:9px 11px;font-size:12px}.blog-header{padding:40px 0 30px}.intro{font-size:15px}.post-grid{grid-template-columns:1fr}.post-card{padding:23px}.post-card h2{font-size:21px}.prose p,.prose li{font-size:15px}.prose h2{font-size:23px}footer{flex-direction:column}}
</style>
